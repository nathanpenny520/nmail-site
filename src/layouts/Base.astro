---
// 全站骨架：顶部导航 + 页脚。中文优先；构建期拿最新版本号做导航栏徽章。
import '../../src/styles/global.css'
import { fetchLatestRelease, versionOf, REPO_URL } from '../../src/lib/releases'

interface Props {
  title: string
  description?: string
  noindex?: boolean // 404 等不该进索引的页：跳过 canonical/og:url，改输出 noindex
}
const { title, description = 'Nmail —— AI 驱动的本地聚合邮箱客户端：AI 分类整理、草稿待审、每日摘要、多账号聚合，数据全程留在本机。', noindex = false } = Astro.props
const release = await fetchLatestRelease()
const version = versionOf(release?.tag_name)
const path = Astro.url.pathname
// SEO：canonical/og:image 必须是绝对 URL；构建期 /download 规范化为 /download/（与 Workers 的 307 一致）
const site = Astro.site ?? new URL('https://nmail.whizzzest.com')
const canonical = new URL(path.endsWith('/') ? path : `${path}/`, site).href
const ogImage = new URL('/icon-512.png', site).href
const nav = [
  { href: '/', label: '首页' },
  { href: '/download/', label: '下载' },
  { href: '/features/', label: '功能' },
  { href: '/docs/', label: '文档' },
  { href: '/changelog/', label: '更新日志' },
  { href: '/posts/', label: '动态' },
]
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Nmail</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={`${title} · Nmail`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nmail" />
    <meta property="og:locale" content="zh_CN" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Nmail 图标" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <meta name="theme-color" content="#4f46e5" />
  </head>
  <body>
    <header>
      <div class="container header-in">
        <a class="brand" href="/">
          <img src="/icon-192.png" alt="Nmail" width="28" height="28" />
          <strong>Nmail</strong>
          {version && <span class="pill ver">v{version}</span>}
        </a>
        <nav>
          {nav.map((item) => (
            <a class:list={[{ active: path === item.href || (item.href !== '/' && path.startsWith(item.href)) }]} href={item.href}>{item.label}</a>
          ))}
          <a href={REPO_URL} target="_blank" rel="noopener">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer>
      <div class="container footer-in">
        <span>© {new Date().getFullYear()} Nmail · MIT License</span>
        <span>
          <a href={REPO_URL} target="_blank" rel="noopener">GitHub</a>
          · <a href="https://whizzzest.com" target="_blank" rel="noopener">whizzzest.com</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, .86);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--ink);
    font-size: 17px;
  }
  .brand:hover { text-decoration: none; }
  .ver { font-size: 12px; padding: 1px 9px; }
  nav { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  nav a { color: var(--ink-soft); font-size: 15px; }
  nav a:hover { color: var(--ink); text-decoration: none; }
  nav a.active { color: var(--accent); font-weight: 600; }
  main { min-height: calc(100vh - 220px); padding-bottom: 56px; }
  footer { border-top: 1px solid var(--line); padding: 26px 0; color: var(--ink-soft); font-size: 14px; }
  .footer-in { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  /* 移动端：header 改两行（品牌 + 单行横滑导航），避免固定高度被换行撑爆 */
  @media (max-width: 720px) {
    .header-in {
      flex-direction: column;
      justify-content: center;
      height: auto;
      gap: 2px;
      padding: 10px 20px 0; /* 覆盖 .container 的 padding，横向上边距必须保留 */
    }
    nav {
      flex-wrap: nowrap;
      gap: 16px;
      max-width: 100%;
      overflow-x: auto;
      padding: 2px 4px 10px; /* 上下 padding 收窄：链接自带 6px 竖向热区，总高不变 */
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    nav::-webkit-scrollbar { display: none; }
    nav a { font-size: 14px; white-space: nowrap; padding: 6px 2px; } /* 补竖向 padding：横滑链接的触控热区到 ~32px */
  }
</style>
