---
// 功能页（REDESIGN_PLAN §10.1）：按用户视角介绍 v0.4.x 已发布的主线能力（随版本迭代补充）。
import Base from '../layouts/Base.astro'

const groups = [
  {
    title: '邮箱，像资源管理器一样',
    items: [
      ['多账号聚合收件箱', 'Gmail / Outlook / QQ / 163 等 20 家预设，添加即用；跨账号智能视图一次看全。'],
      ['文件夹树 · 拖拽 · 右键', '新建/重命名/删除服务器文件夹，邮件多选、拖拽移动、右键批量操作，快捷键 j/k/e/# 齐备。'],
      ['真实归档', '归档 = 每个账号服务器端的 Archived 文件夹，网页端邮箱里同样可见，随时拖回撤销。'],
    ],
  },
  {
    title: 'AI 总管家',
    items: [
      ['对话式操作', '「把上周的营销邮件归档，然后给老张回一封」——搜、读、整理、起草、发送，对话完成。'],
      ['审批 / 自动双模式', '默认每一步等你批准（可改参数再批）；AI 专属邮箱可开自动模式，收件人白名单+每日限额兜底。'],
      ['跨会话记忆', '你明说的偏好与纠正存进本机记忆库，后续对话自动带上；设置里可查看/编辑/删除，数据不出机器。'],
      ['拿不准先问你', '信息不足时 AI 暂停出「向你确认」卡（选项按钮+自由输入），答完接着跑——不自作主张猜错方向。'],
      ['内置工作流技能', '周报摘要、跟进提醒、批量归档策略、报销发票整理——开箱即用的方法论，说一句「做个周报」就开干。'],
      ['全量审计 · 一键撤销', '移动/归档/标记全部留痕，做完不放心？一键移回原样。'],
    ],
  },
  {
    title: '写信与草稿',
    items: [
      ['AI 拟稿 · 人工把关', '需回复的邮件 AI 先起草进「待审」，可改可弃，批准才发；发送永远经过你的手。'],
      ['富文本写信台', 'TipTap 编辑器：字体/颜色/列表/表格/图片/引用，附件即传即存，定时发送、模板、签名。'],
      ['通讯录自动积累', '往来地址自动入册，写信时收件人自动联想，不用再手打地址。'],
    ],
  },
  {
    title: '自动化与集成',
    items: [
      ['每日摘要', '固定时间一份综述：收件概况、重要邮件、待回复清单，统计图表本地生成零 AI 成本。'],
      ['AI 摘要', '总管家到点巡箱总结并拟好回复草稿（只进待审，绝不自动发送）；摘要页可随时重新生成，通知中心展开即读全文。'],
      ['对外 API 与 CLI', '本机 /api/ext/v1：API Key + scope 分级，iOS 快捷指令、Raycast、n8n 随便接；nmail-cli agent ask 一条命令委托内置总管家。'],
      ['本地隐私', '服务只监听 127.0.0.1，数据与密钥全在本机；不注册账号、不连云端、MIT 开源。'],
    ],
  },
]
---

<Base title="功能" description="Nmail 功能一览：资源管理器式邮箱管理、AI 总管家（审批/自动双模式、跨会话记忆、工作流技能）、每日摘要与 AI 摘要、统一草稿、通讯录联想、对外 API 与 CLI、本地隐私。">
  <section class="head">
    <h1>功能一览</h1>
    <p class="sub">v0.4.x 已上线的主线能力；随版本迭代持续补充。</p>
  </section>

  <section class="shots">
    <figure>
      <img src="/shots/nmail-demo-inbox.png" alt="多账号聚合收件箱：AI 分类标签、文件夹树、三栏布局" width="340" loading="lazy" />
      <figcaption>聚合收件箱</figcaption>
    </figure>
    <figure>
      <img src="/shots/nmail-demo-assistant.png" alt="AI 总管家对话页：一句话任务，多步执行，写操作先审批" width="340" loading="lazy" />
      <figcaption>AI 总管家</figcaption>
    </figure>
    <figure>
      <img src="/shots/nmail-demo-digest.png" alt="每日摘要页：统计卡片、近 7 天图表、分类分布、待回复清单" width="340" loading="lazy" />
      <figcaption>每日摘要</figcaption>
    </figure>
  </section>

  {groups.map((g) => (
    <section class="group">
      <h2>{g.title}</h2>
      <div class="grid">
        {g.items.map(([t, d]) => (
          <article class="card">
            <h3>{t}</h3>
            <p>{d}</p>
          </article>
        ))}
      </div>
    </section>
  ))}
  <section class="cta-band">
    <a class="btn btn-primary" href="/download/">立即体验</a>
    <a class="btn btn-ghost" href="/docs/">阅读文档</a>
  </section>
</Base>

<style>
  .head { padding: 52px 0 4px; }
  h1 { margin: 0; font-size: 32px; }
  .sub { color: var(--ink-soft); }

  /* 界面速览：三图一行，窄屏堆叠 */
  .shots { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 18px; margin: 26px 0 8px; }
  .shots figure { margin: 0; }
  .shots img {
    width: 100%; height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 14px 36px rgba(15, 23, 42, .10);
  }
  .shots figcaption { color: var(--ink-soft); font-size: 13.5px; text-align: center; margin-top: 9px; }
  @media (max-width: 720px) { .shots { grid-template-columns: 1fr; } }

  .group { margin: 30px 0 6px; }
  h2 { font-size: 21px; margin: 0 0 12px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }
  .card { border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; background: #fff; }
  .card h3 { margin: 0 0 6px; font-size: 16px; }
  .card p { margin: 0; color: var(--ink-soft); font-size: 14px; }
  .cta-band { display: flex; gap: 14px; margin: 38px 0 10px; flex-wrap: wrap; }
</style>
